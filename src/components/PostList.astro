---
import type { Post } from '../lib/posts';
import { formatDate } from '../lib/posts';
import { postUrl } from '../lib/url';
import TagPill from './TagPill.astro';
import { AUTHOR, AUTHOR_AVATAR } from '../consts';

interface Props {
  posts: Post[];
}

const { posts } = Astro.props;
---

{
  posts.length === 0 ? (
    <p class="empty">还没有文章。</p>
  ) : (
    <ul class="post-grid">
      {posts.map((post) => (
        <li class="post-card">
          {post.data.cover ? (
            <a class="post-card-cover" href={postUrl(post.id)}>
              <img src={post.data.cover} alt={post.data.title} loading="lazy" />
            </a>
          ) : (
            <div class="post-card-cover post-card-cover-placeholder" aria-hidden="true">✿</div>
          )}
          <div class="post-card-body">
            <h2 class="post-card-title">
              <a href={postUrl(post.id)}>{post.data.title}</a>
            </h2>
            {post.data.summary && <p class="post-card-summary">{post.data.summary}</p>}
            <div class="post-card-footer">
              <span class="post-card-author">
                <img src={AUTHOR_AVATAR} alt="" width="20" height="20" />
                <span>{AUTHOR}</span>
              </span>
              <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
              {post.data.tags.length > 0 && (
                <div class="tag-list">
                  {post.data.tags.map((tag) => (
                    <TagPill tag={tag} />
                  ))}
                </div>
              )}
            </div>
          </div>
        </li>
      ))}
    </ul>
  )
}

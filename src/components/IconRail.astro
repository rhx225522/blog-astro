---
import { withBase } from '../lib/url';

const LINKS = [
  {
    label: '首页',
    href: '/',
    icon: '<path d="M3 11.5 12 4l9 7.5"/><path d="M5.5 10v9h13v-9"/>',
  },
  {
    label: '作品',
    href: '/works/',
    icon: '<rect x="4" y="4" width="16" height="16" rx="2"/><path d="M9 15l2-5 3 3 2-4"/>',
  },
  {
    label: '文章',
    href: '/posts/',
    icon: '<path d="M6 3h9l3 3v15H6z"/><path d="M9 9h6M9 13h6M9 17h4"/>',
  },
  {
    label: '说说',
    href: '/says/',
    icon: '<path d="M4 5h16v11H9l-5 4z"/><path d="M8 9h8M8 12h5"/>',
  },
  {
    label: '关于',
    href: '/about/',
    icon: '<circle cx="12" cy="8" r="3.5"/><path d="M5 20c1.4-3 3.9-4.5 7-4.5s5.6 1.5 7 4.5"/>',
  },
];
---

<nav class="icon-rail" aria-label="站点快捷入口">
  {
    LINKS.map((link) => (
      <a href={withBase(link.href)} title={link.label} aria-label={link.label}>
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          set:html={link.icon}
        ></svg>
      </a>
    ))
  }
</nav>

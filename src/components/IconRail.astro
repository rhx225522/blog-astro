---
import { withBase } from '../lib/url';

const LINKS = [
  {
    label: '首页',
    href: '/',
    icon: '<path d="M3 11.5 12 4l9 7.5"/><path d="M5.5 10v9h13v-9"/>',
  },
  {
    label: '归档',
    href: '/archive/',
    icon: '<rect x="4" y="4" width="16" height="5" rx="1.5"/><path d="M5.5 9v9a1 1 0 0 0 1 1h11a1 1 0 0 0 1-1V9"/><path d="M10 13h4"/>',
  },
  {
    label: '标签',
    href: '/tags/',
    icon: '<path d="M3.5 12.5 11 5h9v9l-7.5 7.5a1.5 1.5 0 0 1-2.1 0l-6-6a1.5 1.5 0 0 1 0-2Z"/><circle cx="16" cy="9" r="1.2" fill="currentColor" stroke="none"/>',
  },
  {
    label: '关于',
    href: '/about/',
    icon: '<circle cx="12" cy="8" r="3.5"/><path d="M5 20c1.4-3 3.9-4.5 7-4.5s5.6 1.5 7 4.5"/>',
  },
  {
    label: 'RSS 订阅',
    href: '/rss.xml',
    icon: '<path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1.4" fill="currentColor" stroke="none"/>',
  },
];
---

<nav class="icon-rail" aria-label="站点快捷入口">
  {
    LINKS.map((link) => (
      <a href={withBase(link.href)} title={link.label} aria-label={link.label}>
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          set:html={link.icon}
        ></svg>
      </a>
    ))
  }
</nav>

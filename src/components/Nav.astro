---
import { NAV, SITE_TITLE, AUTHOR_AVATAR } from '../consts';
import { withBase } from '../lib/url';

const normalize = (path: string) => path.replace(/\/+$/, '') || '/';
const current = normalize(Astro.url.pathname);

const isActive = (href: string) => {
  const target = normalize(withBase(href));
  if (target === '/') return current === '/';
  return current === target || current.startsWith(`${target}/`);
};
---

<header class="site-header">
  <div class="nav-pill">
    <a class="nav-avatar" href={withBase('/')} aria-label={`回到${SITE_TITLE}首页`}>
      <img src={AUTHOR_AVATAR} alt={`${SITE_TITLE} 的头像`} width="38" height="38" />
    </a>

    <nav id="site-nav" class="site-nav" aria-label="主导航">
      {
        NAV.map((item) => (
          <a href={withBase(item.href)} aria-current={isActive(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
      <a href={withBase('/rss.xml')} title="RSS 订阅">RSS</a>
    </nav>

    <div class="nav-actions">
      <button id="theme-toggle" class="icon-btn theme-toggle" type="button" aria-label="切换明暗主题">
        ◐
      </button>
      <button
        id="nav-toggle"
        class="nav-toggle icon-btn"
        type="button"
        aria-expanded="false"
        aria-controls="site-nav"
        aria-label="展开导航"
      >
        <span class="nav-toggle-bars" aria-hidden="true"></span>
      </button>
    </div>
  </div>
</header>

<script>
  let navAbort: AbortController | undefined;

  // View Transitions 每次导航后节点会被替换，因此统一在 astro:page-load 里重新绑定
  document.addEventListener('astro:page-load', () => {
    navAbort?.abort();
    navAbort = new AbortController();
    const signal = navAbort.signal;

    const header = document.querySelector('.site-header');
    const toggle = document.getElementById('nav-toggle');
    const nav = document.getElementById('site-nav');

    if (header && toggle && nav) {
      const setOpen = (open: boolean) => {
        toggle.setAttribute('aria-expanded', String(open));
        nav.classList.toggle('is-open', open);
      };

      toggle.addEventListener(
        'click',
        () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'),
        { signal }
      );

      // 点击菜单项后收起，键盘 Esc 与点击外部也收起
      nav.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => setOpen(false), { signal });
      });

      document.addEventListener(
        'click',
        (event) => {
          if (!header.contains(event.target as Node)) setOpen(false);
        },
        { signal }
      );

      document.addEventListener(
        'keydown',
        (event) => {
          if (event.key === 'Escape') setOpen(false);
        },
        { signal }
      );

      // 从移动端切回桌面宽度时重置状态
      window.addEventListener('resize', () => setOpen(false), { passive: true, signal });
    }

    const themeButton = document.getElementById('theme-toggle');
    themeButton?.addEventListener(
      'click',
      () => {
        const current = document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light';
        const next = current === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        try {
          localStorage.setItem('theme', next);
        } catch {
          /* 隐私模式下写入失败不影响切换 */
        }
      },
      { signal }
    );
  });
</script>

---
import BaseLayout from './BaseLayout.astro';
import TagPill from '../components/TagPill.astro';
import Sidebar from '../components/Sidebar.astro';
import Comment from '../components/Comment.astro';
import type { Post } from '../lib/posts';
import { formatDate } from '../lib/posts';
import { postUrl } from '../lib/url';

interface Props {
  post: Post;
  prev?: Post | null;
  next?: Post | null;
  allPosts?: Post[];
}

const { post, prev = null, next = null, allPosts = [] } = Astro.props;
const { title, date, updated, summary, tags } = post.data;
---

<BaseLayout title={title} description={summary ?? title} type="article">
  <div class="layout">
    <article class="layout-main">
      <header class="post-header">
        <h1>{title}</h1>
        <div class="post-meta">
          <time datetime={date.toISOString()}>{formatDate(date)}</time>
          {updated && <span>更新于 {formatDate(updated)}</span>}
        </div>
        {
          tags.length > 0 && (
            <div class="tag-list">
              {tags.map((tag) => (
                <TagPill tag={tag} />
              ))}
            </div>
          )
        }
      </header>

      <div class="post-body">
        <slot />
      </div>

      <Comment />
    </article>

    <div class="layout-side">
      <nav class="side-card toc" aria-label="本文目录">
        <h3 class="side-title">目录</h3>
        <ul id="toc-list" class="toc-list"></ul>
      </nav>
      {allPosts.length > 0 && <Sidebar posts={allPosts} />}
    </div>
  </div>

  {
    (prev || next) && (
      <nav class="post-nav" aria-label="文章导航">
        {prev ? (
          <a href={postUrl(prev.id)}>
            <span aria-hidden="true">← </span>上一篇：{prev.data.title}
          </a>
        ) : (
          <span />
        )}
        {next && (
          <a class="next" href={postUrl(next.id)}>
            下一篇：{next.data.title}
            <span aria-hidden="true"> →</span>
          </a>
        )}
      </nav>
    )
  }
</BaseLayout>

<script>
  // View Transitions 下页面会被替换，目录需要在每次导航后重建
  document.addEventListener('astro:page-load', () => {
    const body = document.querySelector('.post-body');
    const tocWrap = document.querySelector('.toc');
    const tocList = document.getElementById('toc-list');

    if (body && tocWrap && tocList) {
      const heads = Array.from(body.querySelectorAll('h2, h3'));
      if (heads.length === 0) {
        tocWrap.style.display = 'none';
      } else {
        tocList.replaceChildren();
        heads.forEach((h, i) => {
          if (!h.id) h.id = `section-${i}`;
          const li = document.createElement('li');
          if (h.tagName === 'H3') li.classList.add('toc-sub');
          const a = document.createElement('a');
          a.href = `#${h.id}`;
          a.textContent = h.textContent ?? '';
          li.appendChild(a);
          tocList.appendChild(li);
        });
      }
    }
  });
</script>
